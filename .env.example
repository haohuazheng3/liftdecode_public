# LiftDecode — environment variables
# Copy to .env.local for development. Values are never committed.
# Only the first block is required to boot the app; everything else degrades
# gracefully (the feature is skipped and /api/health reports the name as missing).

# --- required -------------------------------------------------------------------

# Neon Postgres, pooled connection string (runtime, HTTP driver)
DATABASE_URL=
# Neon direct (non-pooled) connection string, used by drizzle-kit migrations
DATABASE_URL_UNPOOLED=
# Clerk publishable key (safe for the browser)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk secret key (server only)
CLERK_SECRET_KEY=
# Stripe secret key (live or test)
STRIPE_SECRET_KEY=
# Signing secret of the Stripe webhook endpoint that points at /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Stripe Price id of the monthly membership
STRIPE_PRICE_MEMBERSHIP=
# Stripe Price id of the single report
STRIPE_PRICE_REPORT=
# Canonical origin of the deployment, no trailing slash (e.g. https://liftdecode.com)
NEXT_PUBLIC_APP_URL=

# --- auth & admin ----------------------------------------------------------------

# Signing secret of the Clerk webhook that points at /api/clerk/webhook (svix, whsec…)
CLERK_WEBHOOK_SIGNING_SECRET=
# Comma-separated emails that may open /admin and read the test inbox. No default: unset = nobody is admin.
ADMIN_EMAILS=

# --- analytics -------------------------------------------------------------------

# FlowGlance public site key, loaded in the browser
NEXT_PUBLIC_FLOWGLANCE_SITE=
# FlowGlance site id for server-side calls
FLOWGLANCE_SITE_ID=

# --- mail & alerts (Cloudflare Email Worker, see infra/email-worker) --------------

# Shared bearer between the mail worker and POST /api/inbox/ingest
INBOX_INGEST_SECRET=
# Base URL of the deployed mail worker (e.g. https://liftdecode-mail.<subdomain>.workers.dev)
EMAIL_WORKER_URL=
# Bearer accepted by the mail worker's POST /notify
EMAIL_WORKER_SECRET=

# --- scheduled jobs (vercel.json) -----------------------------------------------

# Vercel sends this as "Authorization: Bearer …" to /api/cron/*; also use it for manual runs
CRON_SECRET=

# --- backups to Cloudflare R2 (S3 API) ------------------------------------------

# Cloudflare account id that owns the bucket
R2_ACCOUNT_ID=
# R2 API token access key id
R2_ACCESS_KEY_ID=
# R2 API token secret access key
R2_SECRET_ACCESS_KEY=
# Bucket that receives backups/<date>.json.gz
R2_BUCKET=

# --- search & content tooling ----------------------------------------------------

# Base64 of the Google service-account JSON with read access to the Search Console property
GOOGLE_SERVICE_ACCOUNT_B64=
# IndexNow key; the same value is served at /<key>.txt
INDEXNOW_KEY=
# Anthropic API key for content tooling scripts (not used at request time)
ANTHROPIC_API_KEY=
